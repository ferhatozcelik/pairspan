# Pairspan — Caching & Server Headers Configuration
# Works with Caddy and Cloudflare Pages (_headers)

# 1. Caddyfile example:
# pairspan.ferhatozcelik.com {
#     root * /var/www/pairspan
#     encode zstd gzip
#     file_server
#
#     @html {
#         path / *.html
#     }
#     header @html Cache-Control "public, no-cache, must-revalidate"
#
#     @static {
#         path *.webp *.png *.svg *.ico *.woff2
#     }
#     header @static Cache-Control "public, max-age=31536000, immutable"
# }

# 2. Cloudflare Pages / Netlify _headers format:
/
  Cache-Control: public, no-cache, must-revalidate

/index.html
  Cache-Control: public, no-cache, must-revalidate

/icon.webp
  Cache-Control: public, max-age=31536000, immutable

/icon.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
