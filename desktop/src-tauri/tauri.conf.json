{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pairspan",
  "version": "1.1.0",
  "identifier": "com.ferhatozcelik.pairspan",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pairspan — Android Device Center",
        "width": 1060,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "widget",
        "title": "Pairspan — Android Device Center",
        "url": "index.html?mode=widget",
        "width": 360,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
